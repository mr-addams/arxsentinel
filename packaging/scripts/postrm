#!/bin/bash
set -euo pipefail

SENTINEL_USER="nginx-sentinel"
LOG_DIR="/var/log/nginx-sentinel"
CFG_DIR="/etc/nginx-sentinel"

case "$1" in
    purge)
        # Remove system user
        if id "${SENTINEL_USER}" &>/dev/null; then
            userdel "${SENTINEL_USER}" || true
        fi

        # Remove logs and config (purge — explicit request for full cleanup)
        rm -rf "${LOG_DIR}"
        rm -rf "${CFG_DIR}"

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;

    remove|upgrade)
        # On upgrade: systemd must re-read the updated unit file
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;
esac
