#!/bin/bash
set -euo pipefail

SENTINEL_USER="arxsentinel"
LOG_DIR="/var/log/arxsentinel"
CFG_DIR="/etc/arxsentinel"

# $1=0 — uninstall; $1=1 — upgrade
if [ "$1" -eq 0 ]; then
    # Remove system user and data on full uninstall
    if id "${SENTINEL_USER}" &>/dev/null; then
        userdel "${SENTINEL_USER}" || true
    fi
    rm -rf "${LOG_DIR}"
    rm -rf "${CFG_DIR}"
fi

# Reload systemd after both install and upgrade to pick up unit changes
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi
