#!/bin/bash
set -euo pipefail

# $1=0 — uninstall; $1=1 — upgrade
# Stop and disable only on full uninstall; on upgrade RPM restarts the service itself.
if [ "$1" -eq 0 ]; then
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet arxsentinel 2>/dev/null; then
            systemctl stop arxsentinel || true
        fi
        if systemctl is-enabled --quiet arxsentinel 2>/dev/null; then
            systemctl disable arxsentinel || true
        fi
    fi
fi
