#!/bin/bash
set -euo pipefail

SENTINEL_USER="arxsentinel"
LOG_DIR="/var/log/arxsentinel"
CFG_DIR="/etc/arxsentinel"
CFG_EXAMPLE="${CFG_DIR}/config.yaml.example"
CFG_FILE="${CFG_DIR}/config.yaml"

# $1=1 — new install; $1=2 — upgrade
if [ "$1" -eq 2 ]; then
    # Upgrade scenario: stop the running daemon before binary replacement
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet arxsentinel 2>/dev/null; then
        systemctl stop arxsentinel || true
    fi
fi

if [ "$1" -eq 1 ]; then
    # Create system user only on fresh install
    if ! id "${SENTINEL_USER}" &>/dev/null; then
        useradd --system --no-create-home \
                --shell /sbin/nologin \
                --comment "arxsentinel daemon" \
                "${SENTINEL_USER}"
    fi
fi

# Fix nginx log directory access on RHEL-like systems.
# AlmaLinux/CentOS ship /var/log/nginx as drwxrwx--- nginx:root, which blocks
# inotify (tail.Watch) for any user outside the nginx group.
# Adding o+rx lets the daemon traverse and read the directory without changing
# ownership. Joining the nginx group provides an alternative path that respects
# the original ACL model — both fixes are applied so either approach works.
if [ -d /var/log/nginx ]; then
    chmod o+rx /var/log/nginx
    usermod -aG nginx "${SENTINEL_USER}" 2>/dev/null || true
fi

# Log directory must exist with correct ownership after both install and upgrade
mkdir -p "${LOG_DIR}"
chown "${SENTINEL_USER}:${SENTINEL_USER}" "${LOG_DIR}"
chmod 750 "${LOG_DIR}"

# Copy example config only when the main config is missing (first install)
if [ -f "${CFG_EXAMPLE}" ] && [ ! -f "${CFG_FILE}" ]; then
    cp "${CFG_EXAMPLE}" "${CFG_FILE}"
    chown "root:${SENTINEL_USER}" "${CFG_FILE}"
    chmod 640 "${CFG_FILE}"
elif [ -f "${CFG_EXAMPLE}" ] && [ -f "${CFG_FILE}" ]; then
    # Upgrade scenario: check for top-level sections present in the example
    # but missing from the user's config. Missing sections mean new features
    # won't be active until the user updates their config manually.
    missing=""
    while IFS= read -r key; do
        if ! grep -qE "^${key}[[:space:]]*:" "${CFG_FILE}"; then
            missing="${missing}  - ${key}\n"
        fi
    done << EOF
$(grep -E '^[a-z_]+:' "${CFG_EXAMPLE}" | sed 's/:.*//' | sort -u)
EOF

    if [ -n "${missing}" ]; then
        echo ""
        echo "┌─────────────────────────────────────────────────────────────────┐"
        echo "│  arxsentinel: config.yaml update required                       │"
        echo "└─────────────────────────────────────────────────────────────────┘"
        echo ""
        echo "  Your existing config is missing the following sections:"
        echo ""
        printf "%b" "${missing}"
        echo ""
        echo "  New features in these sections will not be active until you add"
        echo "  them. See the example config for reference:"
        echo "    ${CFG_EXAMPLE}"
        echo ""
        echo "  After updating detectors/scoring/blocklists — reload is enough:"
        echo "    kill -HUP \$(cat /run/arxsentinel/arxsentinel.pid)"
        echo "  After updating executors (CF credentials, list name, sources) — restart required:"
        echo "    systemctl restart arxsentinel"
        echo ""
    fi
fi

# Guard: systemd may be absent in Docker/chroot/mock
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true

    # On upgrade, restart the service after daemon-reload. On fresh install, user starts manually.
    if [ "$1" -eq 2 ]; then
        systemctl start arxsentinel || true
    fi
fi

if [ "$1" -eq 1 ]; then
    echo ""
    echo "arxsentinel installed."
    echo ""
    echo "Review and edit the config if needed:"
    echo "  ${CFG_FILE}"
    echo ""
    echo "Then enable and start the service:"
    echo "  systemctl enable --now arxsentinel"
    echo ""
fi
