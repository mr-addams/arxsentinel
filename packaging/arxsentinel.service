[Unit]
Description=ArxSentinel — security event pipeline engine
Documentation=https://github.com/mr-addams/arxsentinel
After=network.target

[Service]
# Type=notify: daemon sends READY=1 via sd_notify after all streams are running.
# systemd waits for the notification before marking the service active.
Type=notify
# Unprivileged system user — access only to arxsentinel logs and its own files.
User=arxsentinel
Group=arxsentinel
# EnvironmentFile is optional (-): absence of the file does not crash the service.
EnvironmentFile=-/etc/arxsentinel/env
# RuntimeDirectory: systemd creates /run/arxsentinel/ owned by the service user before
# ExecStart — the process can write its PID file there without root privileges.
RuntimeDirectory=arxsentinel
# Ready-to-use recipe configs: /usr/share/arxsentinel/cookbook/
ExecStart=/usr/bin/arxsentinel
# Restart=on-failure: restart on crash, but not on systemctl stop (ExitCode=0).
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arxsentinel

[Install]
WantedBy=multi-user.target
