# ArxSentinel — Docker Compose environment variables
# Copy this file to .env and adjust values for your setup.
#
# Usage:
#   cp deploy/docker/.env.example deploy/docker/.env
#   docker compose -f deploy/docker/docker-compose.yml up -d
#
# Two kinds of env vars:
#   1. Docker-level (LOG_FILE, THREAT_LOG_DIR, METRICS_PORT) — compose.yml bind mounts.
#   2. ARXSENTINEL_* — config overrides, injected into the container as environment variables.
#
# ARXSENTINEL_* vars override the mounted config.yaml field-by-field.
# Only set what you actually want to override — unset vars use config.yaml values.
# Full list and defaults: internal/sys/config/config.go (applyEnvOverrides function).

# ── Docker-level (used by docker-compose.yml bind mounts) ─────────────────────────────

# Path to the nginx/web server access log on the host.
# The file is bind-mounted into the container read-only.
LOG_FILE=/var/log/nginx/access.log

# Host directory where ArxSentinel writes its threat log and operational log.
# Fail2Ban on the host reads threats.log from this directory.
# Must be writable by uid 65532 (container nonroot user):
#   sudo mkdir -p /var/log/arxentinel
#   sudo chown 65532:65532 /var/log/arxentinel
THREAT_LOG_DIR=/var/log/arxsentinel

# Prometheus metrics listen address inside the container (default :9117).
# Change if 9117 is already occupied on your host.
METRICS_PORT=9117

# ── ARXSENTINEL_* config overrides ────────────────────────────────────────────────────
# Uncomment and set only the vars you want to override.
# Absent vars use the values from the mounted config.yaml (or Go defaults).
#
# YAML-only features (no env var equivalent — configure by editing config.yaml):
#   streams:    — multi-source monitoring (multiple log files independently)
#   inputs:     — universal log source syntax (file, stdin, exec plugin, syslog network receiver)
#   outputs:    — universal threat sink syntax (file, stdout, exec plugin)
#   executors:  — automated threat response (Cloudflare, custom scripts)
#   pipelines:  — advanced per-source detector tuning and shared IP state
# Array fields like overflow.suspicious_params, probe.paths can only be configured via YAML.
# Full examples: /etc/arxsentinel/config.yaml.example (inside container)

# ── general ───────────────────────────────────────────────────────────────────────────
# Access log path inside the container
# ARXSENTINEL_GENERAL_LOG_FILE=/var/log/nginx/access.log
# PID file path (used for SIGHUP and SIGTERM)
# ARXSENTINEL_GENERAL_PID_FILE=/run/arxsentinel/arxsentinel.pid
# Channel buffer size between source and parser stages
# ARXSENTINEL_GENERAL_LINES_BUF_SIZE=1000
# How long to wait before retrying to tail an unavailable file (e.g. after logrotate)
# ARXSENTINEL_GENERAL_TAIL_RETRY_INTERVAL=5s
# How often to log STATS line to operational log (processed/tracked/threats/suspicious)
# ARXSENTINEL_GENERAL_STATS_INTERVAL=300s

# ── logging ───────────────────────────────────────────────────────────────────────────
# Enable debug log tags (PARSER, DETECTOR, SCORER) in operational log
# ARXSENTINEL_LOGGING_DEBUG=false
# Enable ANSI color output for console (disable when logging to file)
# ARXSENTINEL_LOGGING_CONSOLE_COLOR=true

# ── parser ────────────────────────────────────────────────────────────────────────────
# Server profile: apache, caddy, traefik, haproxy-http, litespeed (nginx works without one)
# ARXSENTINEL_PARSER_PROFILE=
# Log format: combined, json, regex (default combined works for nginx)
# ARXSENTINEL_PARSER_LOG_FORMAT=combined
# Go regex pattern (required when log_format=regex)
# ARXSENTINEL_PARSER_REGEX_PATTERN=
# Timezone for log timestamps (reserved, not yet connected)
# ARXSENTINEL_PARSER_TIMEZONE=UTC
# JSON field name mapping (used when log_format=json):
# JSON key → client IP field name
# ARXSENTINEL_PARSER_JSON_REMOTE_ADDR=remote_addr
# JSON key → timestamp field name
# ARXSENTINEL_PARSER_JSON_TIME=time_iso8601
# JSON key → request line field name
# ARXSENTINEL_PARSER_JSON_REQUEST=request
# JSON key → HTTP status field name
# ARXSENTINEL_PARSER_JSON_STATUS=status
# JSON key → response size (bytes sent) field name
# ARXSENTINEL_PARSER_JSON_BYTES_SENT=bytes_sent
# JSON key → Referer header field name
# ARXSENTINEL_PARSER_JSON_REFERER=http_referer
# JSON key → User-Agent header field name
# ARXSENTINEL_PARSER_JSON_USER_AGENT=http_user_agent
# JSON key → real client IP (when behind a reverse proxy) field name
# ARXSENTINEL_PARSER_JSON_REAL_IP=real_ip

# ── scoring ───────────────────────────────────────────────────────────────────────────
# Score threshold above which a WARN is written to the threat log
# ARXSENTINEL_SCORING_ALERT_THRESHOLD=50
# Score threshold above which a THREAT is written + Fail2Ban ban is triggered
# ARXSENTINEL_SCORING_BAN_THRESHOLD=80
# Time window over which scores accumulate and linearly decay
# ARXSENTINEL_SCORING_OBSERVATION_WINDOW=300s
# Decay algorithm (currently only linear is supported)
# ARXSENTINEL_SCORING_DECAY=linear

# ── state ─────────────────────────────────────────────────────────────────────────────
# How often to sweep and remove inactive IPs from the tracker (LRU eviction)
# ARXSENTINEL_STATE_GC_INTERVAL=60s
# Maximum number of IPs tracked simultaneously (~2.5 KB per IP → ~250 MB at 100k)
# ARXSENTINEL_STATE_MAX_TRACKED_IPS=100000

# ── detectors — probe scanner ─────────────────────────────────────────────────────────
# Enable probe scanner — detects requests to /.env, /.git, /wp-config.php, etc.
# ARXSENTINEL_DETECTORS_PROBE_ENABLED=true
# Score assigned per probe path hit
# ARXSENTINEL_DETECTORS_PROBE_SCORE=25

# ── detectors — rate anomaly ──────────────────────────────────────────────────────────
# Enable rate anomaly detector — flags IPs exceeding requests threshold per window
# ARXSENTINEL_DETECTORS_RATE_ENABLED=true
# Number of requests per window that triggers a rate hit
# ARXSENTINEL_DETECTORS_RATE_THRESHOLD=100
# Sliding window duration for rate counting
# ARXSENTINEL_DETECTORS_RATE_WINDOW=60s
# Score assigned per rate hit
# ARXSENTINEL_DETECTORS_RATE_SCORE=25

# ── detectors — bruteforce (404 ratio) ───────────────────────────────────────────────
# Enable bruteforce detector — flags IPs with a high ratio of 404 responses
# ARXSENTINEL_DETECTORS_BRUTEFORCE_ENABLED=true
# Minimum number of requests before the ratio check is evaluated
# ARXSENTINEL_DETECTORS_BRUTEFORCE_MIN_REQUESTS=10
# Fraction of 404 responses above which the IP is flagged (e.g. 0.6 = 60%)
# ARXSENTINEL_DETECTORS_BRUTEFORCE_RATIO_THRESHOLD=0.6
# Score assigned per bruteforce hit
# ARXSENTINEL_DETECTORS_BRUTEFORCE_SCORE=30

# ── detectors — crawler (sequential URLs) ────────────────────────────────────────────
# Enable sequential crawler detector — flags IPs hitting /page/1, /page/2, … in a row
# ARXSENTINEL_DETECTORS_CRAWLER_ENABLED=true
# Minimum number of sequential numeric URLs before the detector triggers
# ARXSENTINEL_DETECTORS_CRAWLER_MIN_SEQUENTIAL=5
# Score assigned per crawler hit
# ARXSENTINEL_DETECTORS_CRAWLER_SCORE=20

# ── detectors — no-asset bot ─────────────────────────────────────────────────────────
# Enable no-asset bot detector — flags IPs that request pages but never load static assets
# ARXSENTINEL_DETECTORS_NOASSET_ENABLED=true
# Minimum page requests before the asset ratio check is evaluated
# ARXSENTINEL_DETECTORS_NOASSET_MIN_PAGE_REQUESTS=3
# Fraction of requests to static assets below which the IP is flagged (0.1 = 10%)
# ARXSENTINEL_DETECTORS_NOASSET_ASSET_RATIO_THRESHOLD=0.1
# Score assigned per no-asset hit
# ARXSENTINEL_DETECTORS_NOASSET_SCORE=20

# ── detectors — user-agent anomaly ───────────────────────────────────────────────────
# Enable User-Agent anomaly detector — flags scanner, grabber, automation tools, empty UA
# ARXSENTINEL_DETECTORS_USERAGENT_ENABLED=true
# Score for scanner UAs (Nuclei, sqlmap, Nikto, etc.)
# ARXSENTINEL_DETECTORS_USERAGENT_SCANNER_SCORE=40
# Score for grabber UAs (wget, HTTrack, curl, etc.)
# ARXSENTINEL_DETECTORS_USERAGENT_GRABBER_SCORE=20
# Score for automation tool UAs (python-requests, aiohttp, Go-http-client, etc.)
# ARXSENTINEL_DETECTORS_USERAGENT_AUTOMATION_SCORE=15
# Score for requests with an empty or missing User-Agent header
# ARXSENTINEL_DETECTORS_USERAGENT_EMPTY_UA_SCORE=30

# ── detectors — overflow / WAF bypass ────────────────────────────────────────────────
# Enable overflow / WAF bypass detector — flags excessively long URLs and bypass keywords
# ARXSENTINEL_DETECTORS_OVERFLOW_ENABLED=true
# URL length threshold (URLs longer than this are flagged as overflow attempts)
# ARXSENTINEL_DETECTORS_OVERFLOW_MAX_URL_LENGTH=2048
# Score assigned per overflow hit
# ARXSENTINEL_DETECTORS_OVERFLOW_SCORE=30
# NOTE: ARXSENTINEL_DETECTORS_OVERFLOW_SUSPICIOUS_PARAMS is YAML-only (array field,
# cannot be set via env var). Configure it in config.yaml under detectors.overflow.

# ── detectors — community bad bot blocklist ───────────────────────────────────────────
# Enable community bad bot blocklist detector — matches UA/referrer against ~685 patterns
# ARXSENTINEL_DETECTORS_BADBOT_ENABLED=true
# Score assigned per blocklist match (default 60 is the highest single-detector score)
# ARXSENTINEL_DETECTORS_BADBOT_SCORE=60
# Check User-Agent header against the badbot-ua blocklist (enabled by default)
# ARXSENTINEL_DETECTORS_BADBOT_CHECK_UA=true
# Check Referer header against the badbot-ref blocklist (~7108 patterns, opt-in)
# ARXSENTINEL_DETECTORS_BADBOT_CHECK_REFERRER=false

# ── whitelist ─────────────────────────────────────────────────────────────────────────
# Score penalty applied when a bot UA fails rDNS/fDNS verification (false positive guard)
# ARXSENTINEL_WHITELIST_FAKE_BOT_SCORE=35
# Timeout for bot DNS verification queries per pipeline request
# ARXSENTINEL_WHITELIST_DNS_VERIFY_TIMEOUT=2s
# TTL for positively verified bot IPs (cache reduces DNS load for Googlebot, Bingbot, etc.)
# ARXSENTINEL_WHITELIST_DNS_CACHE_POSITIVE_TTL=24h
# TTL for failed bot verifications (prevents repeated lookups of unverifiable IPs)
# ARXSENTINEL_WHITELIST_DNS_CACHE_NEGATIVE_TTL=1h
# How often to refresh the hardcoded bot IP range list (Google, Bing, Yandex, DuckDuckGo)
# ARXSENTINEL_WHITELIST_DNS_CACHE_IP_LIST_REFRESH=24h
# Trusted IPs (comma-separated) — these IPs skip all detectors entirely
# ARXSENTINEL_WHITELIST_CUSTOM_IPS=10.0.0.1,192.168.1.100
# Trusted subnets (comma-separated CIDR notation)
# ARXSENTINEL_WHITELIST_CUSTOM_CIDRS=10.0.0.0/8

# ── chain guard — proxy chain integrity checker ───────────────────────────────────────
# Enable proxy chain integrity check — detects Cloudflare/bogon IPs appearing as client IP
# ARXSENTINEL_CHAIN_GUARD_ENABLED=false
# File path for proxy chain warning messages (must be writable by container user)
# ARXSENTINEL_CHAIN_GUARD_WARNINGS_LOG=/var/log/arxsentinel/warnings.log
# Check whether the client IP belongs to a Cloudflare edge IP range (indicates broken proxy)
# ARXSENTINEL_CHAIN_GUARD_CLOUDFLARE_ENABLED=true
# How often to refresh the Cloudflare IP range list from the Cloudflare API
# ARXSENTINEL_CHAIN_GUARD_CLOUDFLARE_REFRESH_INTERVAL=24h
# Check whether the client IP is a bogon/RFC1918/CGNAT address (always from internal network)
# ARXSENTINEL_CHAIN_GUARD_BOGON_ENABLED=true

# ── blocklist — persistent pattern cache ─────────────────────────────────────────────
# Persistent blocklist cache path ("" = in-memory only; file path = bbolt, survives restarts)
# ARXSENTINEL_BLOCKLIST_STORAGE=

# ── output ────────────────────────────────────────────────────────────────────────────
# Path for the Fail2Ban threat log (one line per THREAT-level event)
# ARXSENTINEL_OUTPUT_THREAT_LOG=/var/log/arxsentinel/threats.log
# Path for the daemon operational log (STARTUP, SHUTDOWN, STATS, CONFIG events)
# ARXSENTINEL_OUTPUT_OPERATIONAL_LOG=/var/log/arxsentinel/sentinel.log

# ── metrics — Prometheus endpoint ─────────────────────────────────────────────────────
# Enable the /metrics Prometheus HTTP endpoint
# ARXSENTINEL_METRICS_ENABLED=false
# Listen address for the metrics HTTP server (host:port or :port)
# ARXSENTINEL_METRICS_LISTEN_ADDR=:9117
# Basic auth username for the /metrics endpoint (empty = no auth)
# ARXSENTINEL_METRICS_USERNAME=prometheus   # (example)
# bcrypt hash of the basic auth password (generate with htpasswd -bnBC 10 "" your-password)
# ARXSENTINEL_METRICS_PASSWORD_HASH=$2y$10$...

# ── pipeline — channel buffer and graceful shutdown tuning ────────────────────────────
# Channel buffer depth between pipeline stages (increase for burst traffic)
# ARXSENTINEL_PIPELINE_BUFFER_SIZE=8192
# Maximum time to wait for the line buffer to drain on SIGTERM before force-exit
# ARXSENTINEL_PIPELINE_SHUTDOWN_TIMEOUT=15s
