# ArxSentinel — Docker Compose environment variables
# Copy this file to .env and adjust values for your setup.
#
# Usage:
#   cp deploy/docker/.env.example deploy/docker/.env
#   docker compose -f deploy/docker/docker-compose.yml up -d
#
# Two kinds of env vars:
#   1. Docker-level (LOG_FILE, THREAT_LOG_DIR, METRICS_PORT) — compose.yml bind mounts.
#   2. ARXSENTINEL_* — config overrides, injected into the container as environment variables.

# ── Docker-level (used by docker-compose.yml bind mounts) ─────────────────────────────

# Path to the nginx/web server access log on the host.
# The file is bind-mounted into the container read-only.
LOG_FILE=/var/log/nginx/access.log

# Host directory where ArxSentinel writes its threat log and operational log.
# Fail2Ban on the host reads threats.log from this directory.
# Must be writable by uid 65532 (container nonroot user):
#   sudo mkdir -p /var/log/arxentinel
#   sudo chown 65532:65532 /var/log/arxentinel
THREAT_LOG_DIR=/var/log/arxsentinel

# Prometheus metrics listen address inside the container (default :9117).
# Change if 9117 is already occupied on your host.
METRICS_PORT=9117

# ── ARXSENTINEL_* config overrides (uncomment and set as needed) ─────────────────────

# Scoring thresholds
# ARXSENTINEL_SCORING_ALERT_THRESHOLD=50
# ARXSENTINEL_SCORING_BAN_THRESHOLD=80
# ARXSENTINEL_SCORING_OBSERVATION_WINDOW=300s

# Logging
# ARXSENTINEL_LOGGING_DEBUG=false

# Parser
# ARXSENTINEL_PARSER_PROFILE=
# ARXSENTINEL_PARSER_LOG_FORMAT=combined

# Detectors — probe scanner
# ARXSENTINEL_DETECTORS_PROBE_ENABLED=true
# ARXSENTINEL_DETECTORS_PROBE_SCORE=25

# Detectors — rate anomaly
# ARXSENTINEL_DETECTORS_RATE_ENABLED=true
# ARXSENTINEL_DETECTORS_RATE_THRESHOLD=100
# ARXSENTINEL_DETECTORS_RATE_WINDOW=60s
# ARXSENTINEL_DETECTORS_RATE_SCORE=25

# Detectors — bruteforce (404 ratio)
# ARXSENTINEL_DETECTORS_BRUTEFORCE_ENABLED=true
# ARXSENTINEL_DETECTORS_BRUTEFORCE_MIN_REQUESTS=10
# ARXSENTINEL_DETECTORS_BRUTEFORCE_RATIO_THRESHOLD=0.6
# ARXSENTINEL_DETECTORS_BRUTEFORCE_SCORE=30

# Detectors — user-agent anomaly
# ARXSENTINEL_DETECTORS_USERAGENT_ENABLED=true
# ARXSENTINEL_DETECTORS_USERAGENT_SCANNER_SCORE=40

# Detectors — community bad bot blocklist
# ARXSENTINEL_DETECTORS_BADBOT_ENABLED=true
# ARXSENTINEL_DETECTORS_BADBOT_SCORE=60

# Whitelist
# ARXSENTINEL_WHITELIST_FAKE_BOT_SCORE=35
# ARXSENTINEL_WHITELIST_CUSTOM_IPS=10.0.0.1,192.168.1.100
# ARXSENTINEL_WHITELIST_CUSTOM_CIDRS=10.0.0.0/8

# Chain guard
# ARXSENTINEL_CHAIN_GUARD_ENABLED=false
# ARXSENTINEL_CHAIN_GUARD_WARNINGS_LOG=/var/log/arxsentinel/warnings.log

# Output
# ARXSENTINEL_OUTPUT_THREAT_LOG=/var/log/arxsentinel/threats.log
# ARXSENTINEL_OUTPUT_OPERATIONAL_LOG=/var/log/arxsentinel/sentinel.log

# Metrics (basic auth)
# ARXSENTINEL_METRICS_USERNAME=prometheus
# ARXSENTINEL_METRICS_PASSWORD_HASH=$2y$10$...
