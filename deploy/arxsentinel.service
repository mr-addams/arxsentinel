[Unit]
Description=ArxSentinel — threat detector for nginx access logs
Documentation=https://github.com/mr-addams/arxsentinel
After=network.target

[Service]
# Type=simple: the Go daemon does not fork, systemd tracks the PID directly.
Type=simple
# Unprivileged system user — access only to arxsentinel logs and its own files.
User=arxsentinel
Group=arxsentinel
# EnvironmentFile is optional (-): absence of the file does not crash the service.
EnvironmentFile=-/etc/arxsentinel/env
ExecStart=/usr/local/bin/arxsentinel
# Restart=on-failure: restart on crash, but not on systemctl stop (ExitCode=0).
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arxsentinel

[Install]
WantedBy=multi-user.target
