# ArxSentinel — Docker Compose environment variables
# Copy this file to .env and adjust values for your setup.
#
# Usage:
#   cp deploy/docker/.env.example deploy/docker/.env
#   docker compose -f deploy/docker/docker-compose.yml up -d

# Path to the nginx/web server access log on the host.
# The file is bind-mounted into the container read-only.
LOG_FILE=/var/log/nginx/access.log

# Host directory where ArxSentinel writes its threat log and operational log.
# Fail2Ban on the host reads threats.log from this directory.
# Must be writable by uid 65532 (container nonroot user):
#   sudo mkdir -p /var/log/arxsentinel
#   sudo chown 65532:65532 /var/log/arxsentinel
THREAT_LOG_DIR=/var/log/arxsentinel

# Prometheus metrics listen address inside the container (default :9117).
# Change if 9117 is already occupied on your host.
METRICS_PORT=9117
