/var/log/nginx-sentinel/threats.log
/var/log/nginx-sentinel/sentinel.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    # copytruncate: MVP — does not require SIGHUP-reload of file descriptors.
    # Known limitation: race window ~1ms between copy and truncate (acceptable for a security log).
    # Proper postrotate: kill -HUP $(cat /var/run/nginx-sentinel.pid) — Task 7.1.
    copytruncate
}
