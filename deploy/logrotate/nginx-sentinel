/var/log/nginx-sentinel/threats.log
/var/log/nginx-sentinel/sentinel.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    # copytruncate: MVP — не требует SIGHUP-reload файловых дескрипторов.
    # Известное ограничение: race window ~1ms между copy и truncate (допустимо для security-лога).
    # Правильный postrotate: kill -HUP $(cat /var/run/nginx-sentinel.pid) — Task 7.1.
    copytruncate
}
