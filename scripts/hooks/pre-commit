#!/usr/bin/env bash
# pre-commit — enforces startup/shutdown invariants and runs the full test suite.
#
# Install: ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# Checks (in order):
#   0. check-config-sync.sh          — verifies all env vars and YAML sections are
#      documented across the entire config chain (config.go → config.yaml →
#      config.docker.yaml → .env.example → README tables). Must pass before tests.
#   1. TestStartupShutdownInvariants — verifies that main.go satisfies all
#      startup/shutdown sequence and WaitGroup tracking invariants (see CLAUDE.md).
#   2. go test ./...                  — full test suite across all packages.
#   3. integration tests             — 6 server types × 7 detectors + chain scenarios.
#   4. go vet ./...                   — catches context misuse, WaitGroup errors,
#      unreachable code, and other static issues.

set -euo pipefail

# Config chain check — only when config chain files are staged.
# Chain: config.go → config.yaml → config.docker.yaml → .env.example → README tables.
CONFIG_CHAIN_PATTERN='internal/sys/config/config\.go|^config\.yaml$|^config\.example\.yaml$|deploy/container/docker/config\.docker\.yaml|deploy/container/docker/\.env\.example|deploy/container/docker/README\.md|deploy/container/k8s/arxsentinel/README\.md'
if git diff --cached --name-only | grep -qE "$CONFIG_CHAIN_PATTERN"; then
  echo "[pre-commit] checking config chain consistency..."
  bash scripts/check-config-sync.sh
else
  echo "[pre-commit] config chain not touched — skipping consistency check"
fi

echo "[pre-commit] checking startup/shutdown invariants..."
go test ./cmd/arxsentinel -run TestStartupShutdownInvariants -count=1 -timeout 30s

echo "[pre-commit] running full test suite..."
go test ./... -count=1 -timeout 120s

echo "[pre-commit] running integration tests..."
bash tests/integration/run.sh

echo "[pre-commit] go vet..."
go vet ./...

echo "[pre-commit] OK"
