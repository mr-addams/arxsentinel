#!/usr/bin/env bash
# pre-commit — enforces startup/shutdown invariants and runs the full test suite.
#
# Install: bash scripts/install-hooks.sh
#
# Checks (in order):
#   0. check-config-sync.sh          — verifies all env vars and YAML sections are
#      documented across the entire config chain (config.go → config.yaml →
#      config.docker.yaml → .env.example → README tables). Must pass before tests.
#   1. TestStartupShutdownInvariants — verifies that main.go satisfies all
#      startup/shutdown sequence and WaitGroup tracking invariants (see CLAUDE.md).
#   2. go test ./...                  — full test suite across all packages.
#   3. go vet ./...                   — catches context misuse, WaitGroup errors,
#      unreachable code, and other static issues.
#
# Integration (tests/integration/run.sh, ~3 min, docker + live servers) moved
# to a dedicated pre-push hook in Flow #071: it is too slow for per-commit
# backstop but enforced locally before a push AND in CI (integration.yml on
# PR→dev) AND by the per-task acceptance gate (agent runs it manually).

set -euo pipefail

# Docs-only commit — nothing to build or test, skip all Go checks.
if ! git diff --cached --name-only | grep -qvE '^docs/'; then
  echo "[pre-commit] docs-only commit — skipping Go checks"
  exit 0
fi

# LICENSE sync check — cmd/arxsentinel/LICENSE must be identical to LICENSE.
# The copy exists because go:embed cannot traverse ../ paths.
if git diff --cached --name-only | grep -qE '^LICENSE$|^cmd/arxsentinel/LICENSE$'; then
  if ! diff -q LICENSE cmd/arxsentinel/LICENSE > /dev/null 2>&1; then
    echo "[pre-commit] ERROR: LICENSE and cmd/arxsentinel/LICENSE are out of sync — copy cmd/arxsentinel/LICENSE from LICENSE before committing"
    exit 1
  fi
fi

# Build-profile consistency — only when profile/plugin files are staged.
# Verifies declaration ↔ generated drift, plugin Register existence, and
# cookbook type ∈ profile membership (scripts/check-build-profiles.sh, Flow 075).
PROFILE_PATTERN='^profiles/|^cmd/arxsentinel/plugins_.*\.go$|^cmd/arxsentinel/main\.go$|^pkg/(source|sink|executor|processor)/|^tools/gen-plugins/'
if git diff --cached --name-only | grep -qE "$PROFILE_PATTERN"; then
  echo "[pre-commit] checking build profiles consistency..."
  bash scripts/check-build-profiles.sh
else
  echo "[pre-commit] build profiles not touched — skipping consistency check"
fi

# Config chain check — only when config chain files are staged.
# Chain: config.go → config.yaml → config.docker.yaml → .env.example → README tables.
CONFIG_CHAIN_PATTERN='internal/sys/config/config\.go|^config\.yaml$|^config\.example\.yaml$|deploy/container/docker/config\.docker\.yaml|deploy/container/docker/\.env\.example|deploy/container/docker/README\.md|deploy/container/k8s/arxsentinel/README\.md'
if git diff --cached --name-only | grep -qE "$CONFIG_CHAIN_PATTERN"; then
  echo "[pre-commit] checking config chain consistency..."
  bash scripts/check-config-sync.sh
else
  echo "[pre-commit] config chain not touched — skipping consistency check"
fi

echo "[pre-commit] checking startup/shutdown invariants..."
go test ./cmd/arxsentinel -run TestStartupShutdownInvariants -count=1 -timeout 30s

echo "[pre-commit] running full test suite..."
# -race adds 2–5x overhead to test runtime; bump timeout from 120s to 300s to
# avoid false timeouts on slow CI/local machines.
go test -race -count=1 ./... -timeout 300s

echo "[pre-commit] go vet..."
go vet ./...

echo "[pre-commit] OK"
